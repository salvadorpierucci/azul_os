# ============================================
# Azul OS - Variables de Entorno
# ============================================
# Copia este archivo como .env y completa con tus valores:
#   cp .env.example .env
# ============================================

# --- Twilio WhatsApp API ---
# Conseguir gratis en https://www.twilio.com/console
# Version trial: solo puede enviar a numeros verificados
TWILIO_ACCOUNT_SID=tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Servidor ---
# Puerto donde escucha el backend (default: 8000)
PORT=8000

# --- Base de datos ---
# Ruta a la DB SQLite (default: data/azul_os.db dentro del proyecto)
# AZUL_DB_PATH=/ruta/absoluta/azul_os.db

# --- Autenticacion (opcional) ---
# Si seteas AZUL_AUTH_TOKEN, se activa la autenticacion.
# Dejalo vacio para modo desarrollo sin auth.
# AZUL_AUTH_TOKEN=
# AZUL_AUTH_PASSWORD=azul

# Para generar un token aleatorio:
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- CORS (opcional) ---
# Orígenes permitidos, separados por coma. Vacío = solo localhost.
# Para acceso desde otra PC en LAN, agregar http://192.168.x.x:8000
# AZUL_CORS_ORIGINS=http://localhost:8000,http://192.168.1.100:8000
